{
  "name": "hono-passkeys",
  "version": "0.1.0",
  "description": "Passkey (WebAuthn) authentication middleware for Hono",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hono",
    "passkey",
    "webauthn",
    "fido2",
    "authentication",
    "middleware"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.6.2",
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2"
  },
  "devDependencies": {
    "hono": "^4.12.28",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
